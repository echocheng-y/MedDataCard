# 复制本文件为 .env 并填入你的 key（.env 已被 .gitignore 排除，不会提交）
# 只需填你准备用的那一个 provider 即可。

# 阿里云百炼 DashScope（provider=dashscope，默认模型 qwen-plus，OpenAI 兼容接口）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI（provider=openai，模型 gpt-4o-mini）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic（provider=anthropic，模型 claude-3-5-haiku-20241022）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
